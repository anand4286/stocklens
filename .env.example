# Copy to .env and fill in. Every value is optional: with none set, StockLens
# runs in offline demo mode with synthetic data and the rules-based analyst.

# --- data ---------------------------------------------------------------
# demo | alpaca
STOCKLENS_DATA_PROVIDER=demo
# Free market-data keys from https://alpaca.markets (market data only; StockLens
# never calls a trading endpoint).
STOCKLENS_ALPACA_API_KEY_ID=
STOCKLENS_ALPACA_API_SECRET_KEY=
STOCKLENS_ALPACA_FEED=iex
# SEC fair-access policy: a descriptive User-Agent with a real contact address.
# Setting it turns on live fundamentals from EDGAR.
STOCKLENS_SEC_USER_AGENT=
STOCKLENS_BENCHMARK_SYMBOL=SPY

# --- storage ------------------------------------------------------------
STOCKLENS_DATABASE_URL=sqlite:///./var/stocklens.db
# STOCKLENS_DATABASE_URL=postgresql+psycopg://stocklens:CHANGE_ME@db:5432/stocklens

# --- security -----------------------------------------------------------
# Set to require "Authorization: Bearer <key>" on every /api route.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STOCKLENS_API_KEY=
STOCKLENS_RATE_LIMIT_PER_MINUTE=60
# Only behind a proxy you control.
STOCKLENS_TRUST_PROXY_HEADERS=false
# JSON list, e.g. ["https://example.com"]. Empty = same-origin only.
STOCKLENS_CORS_ORIGINS=[]

# --- AI analyst agent -----------------------------------------------------
STOCKLENS_ANTHROPIC_API_KEY=
STOCKLENS_AGENT_MODEL=claude-opus-5-5
STOCKLENS_AGENT_EFFORT=medium
STOCKLENS_AGENT_MAX_STEPS=8
STOCKLENS_AGENT_CACHE_MINUTES=60
STOCKLENS_AGENT_DAILY_LIMIT=50
# Let anonymous visitors trigger paid model runs. Leave false on public sites.
STOCKLENS_AGENT_PUBLIC=false
STOCKLENS_AGENT_RATE_LIMIT_PER_MINUTE=3

STOCKLENS_LOG_LEVEL=INFO
STOCKLENS_LOG_JSON=true
